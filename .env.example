# ============================================
# Loop Closer — Environment Variables
# ============================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file to version control.

# Caspian SDK
CASPIAN_API_KEY=your_caspian_api_key_here

# Slack Integration
SLACK_TOKEN=xoxb-your-slack-bot-token-here
SLACK_APP_TOKEN=
# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI — Commitment Extraction (intelligence.py)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Webhook Security
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_string_here
